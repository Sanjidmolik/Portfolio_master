# Copy to .env and fill in. NEVER commit .env.

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development | production (production enables secure cookies, HSTS, strict CSRF)
APP_ENV=development

# Database. Leave empty for a local SQLite file in instance/portfolio.db
# DATABASE_URL=postgresql://user:password@localhost:5432/portfolio
DATABASE_URL=

# First admin account (created on startup only if no admin exists).
# Remove ADMIN_PASSWORD after the first start. Or use: flask --app app create-admin
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Public base URL (used for canonical links, sitemap and Open Graph tags)
SITE_URL=

# Behind a reverse proxy (Render, Nginx, etc.)? Set to 1 so client IPs/HTTPS are detected.
TRUST_PROXY=

# Optional: GitHub token (server-side only) for the full contribution calendar
# and higher API limits. A fine-grained token with no extra permissions is enough.
GITHUB_TOKEN=
GITHUB_CACHE_SECONDS=3600

# Optional: email notifications for new contact messages
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
CONTACT_NOTIFY_EMAIL=

# Rate limits (Flask-Limiter syntax). Use a Redis URI for multi-process deployments.
LOGIN_RATE_LIMIT=5 per minute;20 per hour
CONTACT_RATE_LIMIT=5 per hour;20 per day
RATELIMIT_STORAGE_URI=memory://
ADMIN_SESSION_HOURS=8
